{
  "version": "2.0.0",
  "tasks": [
    {
      "icon": { "color": "terminal.ansiCyan", "id": "github" },
      "label": "git",
      "type": "shell",
      "command": "pwsh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "icon": { "color": "terminal.ansiBlue", "id": "server" },
      "label": "docker",
      "type": "shell",
      "command": "pwsh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "icon": { "color": "terminal.ansiGreen", "id": "terminal-cmd" },
      "label": "dotnet",
      "type": "shell",
      "command": "pwsh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "icon": { "color": "terminal.ansiYellow", "id": "tools" },
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/AppHost/AppHost.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
